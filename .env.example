# Адрес сайта без слэша на конце (нужен для ссылок, sitemap и возврата после оплаты)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ЮKassa: Настройки -> Ключи API. Без них заказы принимаются без онлайн-оплаты.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — передавать чек по 54-ФЗ (если подключена онлайн-касса или «Чеки от ЮKassa»)
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС в чеке: 1 — без НДС
YOOKASSA_VAT_CODE=1

# Уведомления о заказах и заявках в Telegram: токен от @BotFather и ваш chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секрет для промокодов Retour: любая длинная случайная строка (openssl rand -hex 32)
RETOUR_SECRET=

# Яндекс Метрика: номер счётчика (необязательно)
NEXT_PUBLIC_YM_ID=
